# Database and public source search
SIGNALTRACE_DATABASE_URL=sqlite:///./signaltrace.db
TAVILY_API_KEY=

# OpenAI-compatible LLM gateway (APInex supported)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.apinex.bond/v1
OPENAI_MODEL=free/gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_JSON_MODE=auto

# Search, retrieval, parsing and concurrency
REQUEST_TIMEOUT_SECONDS=15
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_RETRIES=2
MAX_RESULTS_PER_QUERY=8
MAX_SEARCH_QUERIES=10
MAX_SOURCE_BYTES=5000000
MAX_PDF_BYTES=40000000
MAX_PDF_PAGES=500
MAX_DOCUMENT_CHARS=400000
MAX_RESEARCH_SOURCES=24
FETCH_CONCURRENCY=4
OCR_ENABLED=false
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
USER_AGENT=SignalTraceResearch/0.3 (public-source research)

# Diagnostics are disabled by default; enable only on trusted local deployments.
EXPOSE_DIAGNOSTICS=false

# Optional API hardening
SIGNALTRACE_API_TOKEN=
RATE_LIMIT_PER_MINUTE=0
